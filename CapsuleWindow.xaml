<Window x:Class="IllusionLauncherWPF.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capsule" Height="56" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid x:Name="ClipContainer" ClipToBounds="True">

        <!-- 宽度固定为 280，居中，留足放大空间 -->
        <Border x:Name="IslandBody" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Height="52" CornerRadius="26" Background="#050505" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="16,0" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseDown="IslandBody_MouseDown">

            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>

            <Border.Triggers>
                <!-- 1. 出场展开动画 -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IslandBody" Storyboard.TargetProperty="Width" From="0" To="280" Duration="0:0:0.7">
                                <DoubleAnimation.EasingFunction>
                                    <QuarticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- 2. 鼠标悬停：原地居中放大 -->
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IslandScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IslandScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- 3. 鼠标离开：原地居中复原 -->
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IslandScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IslandScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ⭐ 文字区域（找回啦！） -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerName" Text="Player" Foreground="White" FontWeight="Black" FontSize="14" FontFamily="Microsoft YaHei"/>
                    <TextBlock x:Name="VersionName" Text="1.21.4" Foreground="#80FFFFFF" FontSize="11" Margin="0,1,0,0" FontFamily="Consolas"/>
                </StackPanel>

                <!-- ⭐ 按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. 截图文件夹（相机图标） -->
                    <Border Width="28" Height="28" CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="OpenScreenshots_Click" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="M4 4h3l2-2h6l2 2h3c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Border>

                    <!-- 2. 展开启动器 -->
                    <Border Width="28" Height="28" CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="Restore_Click" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="10" Height="10"/>
                    </Border>

                    <!-- 3. 关闭游戏 -->
                    <Border Width="28" Height="28" CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="Close_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#66FF8080"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="M18 6L6 18M6 6l12 12" Stroke="#FF8080" StrokeThickness="2" Stretch="Uniform" Width="10" Height="10"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>