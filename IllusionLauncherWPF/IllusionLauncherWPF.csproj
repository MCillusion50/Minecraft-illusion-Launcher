<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>0.1.5.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
<UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>IllusionLauncherWPF</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="ProjBobcat" Version="2.1.2" />
<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
      </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qomicex.Connector\Qomicex.Connector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- EasyTier: the files needed for LAN play.
         注意：easytier-cli.exe（6MB）必须保留！加房时 CenterDiscoveryService 靠它执行 `peer`
         枚举对端主机名，缺了它永远发现不了联机中心，30 秒后报「未在 EasyTier 网络中发现联机中心」。
         已移除 easytier-web-embed.exe / easytier-web.exe（约 61MB）。
         Keep the EasyTier\ folder level: code resolves BaseDirectory\EasyTier\. -->
    <Content Include="EasyTier\easytier-core.exe;EasyTier\easytier-cli.exe;EasyTier\wintun.dll;EasyTier\WinDivert64.sys;EasyTier\Packet.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- wwwroot 下的 _backup_* 是临时备份，不打进安装包 -->
    <Content Include="wwwroot\**\*" Exclude="wwwroot\_backup_*\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="aria2c.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>