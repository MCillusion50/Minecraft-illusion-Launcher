<Window x:Class="IllusionLauncherWPF.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft illusion Launcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="760" Height="720">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="LogoImage"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetName="LogoImage"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <!-- 光圈呼吸：让开场动画里的 logo 是"活着"的 -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="ScaleRoot"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.045" Duration="0:0:1.7">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScaleRoot"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.045" Duration="0:0:1.7">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="Transparent">
        <!-- 矢量光圈 logo（替代原 Assets/SplashLogo.png 位图），
             和安装器、应用图标是同一套视觉语言 -->
        <Grid x:Name="LogoImage"
              Width="400" Height="400"
              Opacity="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ScaleRoot" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- 外围弥散光晕 -->
            <Ellipse Width="210" Height="210" Stroke="#3DFFFFFF" StrokeThickness="30">
                <Ellipse.Effect>
                    <BlurEffect Radius="40"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 主光圈 -->
            <Ellipse Width="210" Height="210" Stroke="#FFFFFF" StrokeThickness="34">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FFFFFF" BlurRadius="46" ShadowDepth="0" Opacity="0.55"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
    </Grid>
</Window>
