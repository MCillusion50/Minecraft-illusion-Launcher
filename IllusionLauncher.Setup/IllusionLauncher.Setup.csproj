<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 仅 Release 带管理员清单：Debug 调试时不起 UAC，方便 VS 边改边调试 -->
    <ApplicationManifest Condition="'$(Configuration)'=='Release'">app.manifest</ApplicationManifest>
    <AssemblyName>IllusionLauncherSetup</AssemblyName>
    <RootNamespace>IllusionLauncher.Setup</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 声明 x64 平台：否则 VS 在解决方案的 x64 配置下找不到该项目，无法设为启动项目 -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.5</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Illusion Launcher 安装程序</Product>
    <Company>MCillusion50</Company>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="bg.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="bg.png">
      <LogicalName>bg.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
