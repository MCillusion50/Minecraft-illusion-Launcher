<Window x:Class="IllusionLauncher.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Illusion Launcher 安装程序"
        Width="480" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Margin="18" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.16" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Illusion Launcher 安装程序"
                           Margin="26,0,0,0" VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
                           Foreground="{StaticResource TextSecondary}"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="✕"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- ================= 第 1 屏：欢迎 ================= -->
            <StackPanel x:Name="ScreenWelcome" Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Margin="0,0,0,26">
                <Border Width="92" Height="92" CornerRadius="24" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E9BFF" Offset="0"/>
                            <GradientStop Color="#0A6BE0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="#0A84FF"/>
                    </Border.Effect>
                    <TextBlock Text="IL" Foreground="White" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI"/>
                </Border>

                <TextBlock Text="Illusion Launcher" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock x:Name="LblVersion" Text="幻境启动器" Style="{StaticResource SubText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <Button Content="开始安装" Style="{StaticResource PillPrimary}"
                        Width="268" Margin="0,34,0,0" Click="BtnStart_Click"/>

                <TextBlock x:Name="LblDefaultPath" Style="{StaticResource SubText}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="11.5"
                           Text="默认安装到 C:\Program Files\IllusionLauncher"/>
            </StackPanel>

            <!-- ================= 第 2 屏：选择位置 ================= -->
            <Grid x:Name="ScreenPath" Grid.Row="1" Visibility="Collapsed" Margin="40,6,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="选择安装位置" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Row="1" Text="建议安装在剩余空间 500 MB 以上的磁盘" Style="{StaticResource SubText}"
                           Margin="0,8,0,0"/>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPath" Grid.Column="0" Style="{StaticResource PillTextBox}"/>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource PillSecondary}"
                            Width="88" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
                </Grid>

                <TextBlock x:Name="LblSpace" Grid.Row="3" Style="{StaticResource SubText}"
                           Margin="4,14,0,0" Text=""/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="返回" Style="{StaticResource PillSecondary}"
                            Width="110" Click="BtnBack_Click"/>
                    <Button Grid.Column="1" Content="安装" Style="{StaticResource PillPrimary}"
                            Margin="12,0,0,0" Click="BtnInstall_Click"/>
                </Grid>
            </Grid>

            <!-- ================= 第 3 屏：安装中 / 完成 ================= -->
            <Grid x:Name="ScreenInstall" Grid.Row="1" Visibility="Collapsed" Margin="40,6,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblInstallTitle" Grid.Row="0" Text="正在安装…"
                           Style="{StaticResource SectionTitle}"/>

                <Border x:Name="TrackBar" Grid.Row="1" Height="8" CornerRadius="4" Background="{StaticResource Fill}"
                        Margin="0,26,0,0">
                    <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left"
                            CornerRadius="4" Background="{StaticResource Accent}"/>
                </Border>

                <TextBlock x:Name="LblStatus" Grid.Row="2" Style="{StaticResource SubText}"
                           Margin="2,14,0,0" Text="准备中…"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                            x:Name="PanelDone" Visibility="Collapsed">
                    <Button Content="完成" Style="{StaticResource PillSecondary}" Width="110"
                            Click="BtnClose_Click"/>
                    <Button Content="立即启动" Style="{StaticResource PillPrimary}" Width="150"
                            Margin="12,0,0,0" Click="BtnLaunch_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
